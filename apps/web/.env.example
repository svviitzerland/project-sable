# Local development: Node 24, one SvelteKit process.
# Leave the Supabase block empty for SQLite + local files, or run `supabase start` at the
# repository root and copy DB_URL, API_URL and SERVICE_ROLE_KEY from `supabase status -o env`.
JUDE_ENV=development
JUDE_RUNTIME=local
JUDE_APP_URL=http://localhost:3000
# JUDE_DATA_DIR=/absolute/path/to/existing/be/.data

# Optional AI, speech and legal integrations. All values remain server-only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
SPEECHMATICS_API_KEY=
PASAL_API_KEY=

# Optional Python voice service (apps/voice). Keeps one label per recurring voice.
# Local: docker compose up voice, then VOICE_API_URL=http://localhost:8000. Hosted: HTTPS only.
VOICE_API_URL=
VOICE_API_TOKEN=

# Supabase. Local CLI defaults: DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# and SUPABASE_URL=http://127.0.0.1:54321 (SUPABASE_SERVICE_ROLE_KEY from `supabase status -o env`).
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=jude-documents

# Hosted deployment: set JUDE_RUNTIME=vercel, JUDE_ENV=production and HTTPS JUDE_APP_URL.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
CRON_SECRET=
# Recovery scheduler: every 15 minutes (96 scheduled deliveries/day, plus jobs/retries).
JUDE_RECOVERY_CRON="*/15 * * * *"
