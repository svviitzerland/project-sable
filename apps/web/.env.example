# Local development: Node 24, one SvelteKit process.
# Leave DATABASE_URL and S3_BUCKET empty for SQLite + local files.
JUDE_ENV=development
JUDE_APP_URL=http://localhost:3000
# JUDE_DATA_DIR=/absolute/path/to/existing/be/.data
# The public demo case is always available in development. In production
# (JUDE_ENV=production) set JUDE_DEMO=1 to offer it.
# JUDE_DEMO=1
# Extra origins allowed to call the API, comma separated (defaults to JUDE_APP_URL).
# ALLOWED_ORIGINS=

# Optional AI, speech and legal integrations. All values remain server-only.
# AI_PROVIDER=bedrock uses Amazon Bedrock through the AWS credential chain (production
# uses the instance role). The model defaults below match production.
# AI_PROVIDER=bedrock
# AWS_REGION=ap-southeast-1
# BEDROCK_MODEL=global.amazon.nova-2-lite-v1:0
# BEDROCK_REVIEW_MODEL=global.moonshotai.kimi-k3
# Amazon Transcribe streaming for microphone and prepared audio. On by default with
# AI_PROVIDER=bedrock; TRANSCRIBE=1 enables it without Bedrock, TRANSCRIBE=0 disables it.
# TRANSCRIBE=
# Optional local alternative to Bedrock for structured AI calls and embeddings.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# Pasal.id legal search (empty disables legal search).
PASAL_API_KEY=

# Optional Python voice service (apps/voice). Keeps one label per recurring voice.
# Local: docker compose up voice, then VOICE_API_URL=http://localhost:8000.
# VOICE_API_TOKEN must be at least 16 characters.
VOICE_API_URL=
VOICE_API_TOKEN=

# Optional PostgreSQL (apply migrations first: cd ../../db && npm ci && npm run migrate)
# and private S3 bucket for originals and recordings.
DATABASE_URL=
# S3_BUCKET=
