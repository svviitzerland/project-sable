# Local development: Node 24, one SvelteKit process.
# Leave DATABASE_URL and S3_BUCKET empty for SQLite + local files.
JUDE_ENV=development
JUDE_APP_URL=http://localhost:3000
# JUDE_DATA_DIR=/absolute/path/to/existing/be/.data

# Optional AI, speech and legal integrations. All values remain server-only.
# AI_PROVIDER=bedrock uses Amazon Bedrock with the AWS credential chain (production);
# otherwise set an OpenRouter key and model.
# AI_PROVIDER=
# AWS_REGION=ap-southeast-1
# BEDROCK_MODEL=global.amazon.nova-2-lite-v1:0
# BEDROCK_REVIEW_MODEL=global.anthropic.claude-sonnet-4-6
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
SPEECHMATICS_API_KEY=
PASAL_API_KEY=

# Optional Python voice service (apps/voice). Keeps one label per recurring voice.
# Local: docker compose up voice, then VOICE_API_URL=http://localhost:8000.
VOICE_API_URL=
VOICE_API_TOKEN=

# Optional PostgreSQL (apply migrations with `node scripts/migrate.mjs`) and private S3 bucket.
DATABASE_URL=
# S3_BUCKET=
