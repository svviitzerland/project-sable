# App (empty DATABASE_URL and S3_BUCKET use local SQLite and files under JUDE_DATA_DIR)
JUDE_ENV=development
JUDE_APP_URL=http://localhost:3000
JUDE_DATA_DIR=.data
JUDE_DEMO=
ALLOWED_ORIGINS=

# AI and speech (AWS credentials from your AWS profile; empty AI_PROVIDER turns AI off)
AI_PROVIDER=
AWS_REGION=ap-southeast-1
BEDROCK_MODEL=global.amazon.nova-2-lite-v1:0
BEDROCK_REVIEW_MODEL=global.moonshotai.kimi-k3
TRANSCRIBE=

# Storage
DATABASE_URL=
S3_BUCKET=

# Integrations
PASAL_API_KEY=

# Voice (apps/voice; token of 16+ characters)
VOICE_API_URL=
VOICE_API_TOKEN=
