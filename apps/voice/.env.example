# Voice (same token as VOICE_API_TOKEN in apps/web/.env.local, 16+ characters)
VOICE_API_TOKEN=change-me-to-a-long-random-secret
VOICE_ENGINE=pyannote
VOICE_EMBEDDING_MODEL=pyannote/wespeaker-voxceleb-resnet34-LM
VOICE_MATCH_THRESHOLD=0.55
VOICE_MIN_CLIP_SECONDS=1.5
VOICE_MAX_CLIP_SECONDS=30
VOICE_MAX_UPLOAD_MB=64
