# Shared secret between Jude (VOICE_API_TOKEN in apps/web/.env.local) and this service. 16+ characters.
VOICE_API_TOKEN=change-me-to-a-long-random-secret
# pyannote (open-source models) or fake (deterministic test engine; not real speaker recognition).
VOICE_ENGINE=pyannote
# Hugging Face token with the pipeline's conditions accepted. Only needed for /v1/diarize.
HF_TOKEN=
# VOICE_EMBEDDING_MODEL=pyannote/wespeaker-voxceleb-resnet34-LM
# VOICE_DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
# Cosine similarity needed to treat two clips as the same voice. Calibrate on your own audio.
# VOICE_MATCH_THRESHOLD=0.55
# VOICE_MIN_CLIP_SECONDS=1.5
# VOICE_MAX_CLIP_SECONDS=30
# VOICE_MAX_RECORDING_SECONDS=10800
# VOICE_MAX_UPLOAD_MB=64
