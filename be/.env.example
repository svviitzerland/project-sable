# Run uvicorn with --env-file .env after copying this file.
JUDE_ENV=development
JUDE_DATA_DIR=.data
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
# Optional Supabase PostgreSQL connection string; SQLite is the local default.
# DATABASE_URL=postgresql+psycopg://postgres:password@host:5432/postgres?sslmode=require
# Keep these backend-only. No provider credentials are sent to the browser.
OPENROUTER_API_KEY=
# Select an account-accessible model supporting strict JSON schema outputs.
OPENROUTER_MODEL=
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
SPEECHMATICS_API_KEY=
SPEECHMATICS_URL=wss://eu.rt.speechmatics.com/v2
PASAL_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=jude-documents
